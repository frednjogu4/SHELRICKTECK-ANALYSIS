# AURUM — server secrets. Copy to .env.local, fill in, then load with:
#   set -a; source .env.local; set +a; npm run api
# Never commit .env.local. All of these are OPTIONAL: without any key the
# workspace runs in honest TECHNICAL mode (real candles, no AI calls).

# --- AI engines (shared $5/day budget across all three) ---
# Keys can ALSO be entered per-device in the app: Settings -> AI engines
# (they ride API requests as x-ai-* headers; server env is the alternative).
ANTHROPIC_API_KEY=            # Claude  -> sk-ant-...
CLAUDE_MODEL=claude-opus-4-1
OPENAI_API_KEY=               # ChatGPT -> sk-...
OPENAI_MODEL=gpt-4o
PERPLEXITY_API_KEY=           # news & research briefs -> pplx-...
PERPLEXITY_MODEL=sonar
DAILY_BUDGET_USD=5
# PORT=4100

# --- Deriv secure proxy (Part 6: server-side token, /api/deriv) ---
# The browser ONLY talks to /api/deriv; the token lives here, in the
# server process. Without these, the platform still runs keyless:
# public data + analysis + backtesting keep working, and trading
# endpoints return a clear 503 listing exactly what is missing.
#
# 1) Get an App ID: https://api.deriv.com/  (Apps -> Create)
# 2) Create a token: Deriv -> Settings -> API token  (scopes: Read + Trade)
# 3) DEMO FIRST: leave DERIV_ENVIRONMENT=demo and trade your Deriv
#    virtual account until the flow is proven; then switch to 'real'.
DERIV_APP_ID=                 # e.g. 1089  (from api.deriv.com)
DERIV_API_TOKEN=              # e.g. abc123...  NEVER commit, NEVER expose to the browser
ENVIRONMENT=demo              # demo = Deriv virtual account (real prices, DEMO label) | real = real-money
DERIV_TRADING_ENABLED=false   # trading stays OFF until you explicitly set 'true'
DERIV_MAX_STAKE_USD=50        # server-side per-trade cap (enforced before proposal)
DERIV_MAX_OPEN_TRADES=5       # server-side concurrent-positions cap
DERIV_DAILY_LOSS_LIMIT_USD=25 # server-side daily loss stop
DERIV_PROXY_RATE_PER_MIN=60   # /api/deriv/* requests per IP per minute
BACKTEST_RATE_PER_MIN=12      # /api/backtest runs per IP per minute
# DERIV_WS_URL=               # optional override; default spec endpoint with automatic fallback

# --- Deriv REAL trading (PAT, legacy runtime path) ---
# Deliberately NOT read from env: the PAT is entered at runtime
# (Connect screen), held in sessionStorage only, sent per-request as
# x-deriv-pat, and never persisted server-side or baked into exports.

# --- Deferred (Phase 1, see SETUP_GUIDE.md) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
